# Endereco de escuta.
#
# `127.0.0.1` atende so esta maquina, e e o certo enquanto o PubliBot roda
# aqui do lado. Para atender a VM da nuvem, troque pelo endereco que o
# Tailscale deu A ESTA MAQUINA (`tailscale ip -4`).
#
# NUNCA 0.0.0.0: isso publica na internet um endpoint que roda modelo na sua
# placa. O instalador recusa.
#
# O valor precisa ser um endereco que exista nesta maquina. O instalador
# tenta escutar nele antes de instalar a unit — um endereco de exemplo nao
# substituido, ou o da Tailscale com o tailscaled parado, faria o servico
# morrer no boot e o systemd reinicia-lo a cada 10s, visivel so no journal.
BIND_HOST=127.0.0.1
BIND_PORT=8100

# Segredo compartilhado com o PubliBot. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WORKER_SHARED_SECRET=

MAX_PDF_BYTES=104857600

# Onde o modelo roda: cpu | cuda | auto.
#
# O Docling NAO exige GPU: a analise de layout roda em CPU, e a placa muda o
# tempo, nao o resultado. Comece em `cpu` numa maquina comum e troque para
# `cuda` quando a placa existir — nada muda no PubliBot, que so fala HTTP com
# este servico. Confira depois em /health/, que devolve o dispositivo em uso.
DOCLING_DEVICE=cpu

# Threads na CPU. Ignorado em GPU. 0 deixa o Docling decidir.
DOCLING_THREADS=0

# OCR le a imagem da pagina, para PDF digitalizado sem camada de texto. E de
# longe a parte mais cara em CPU e a maioria dos artigos nao precisa. Ligue
# quando encontrar um PDF escaneado.
DOCLING_OCR=false

# ---------------------------------------------------------------------------
# Geracao de imagem de capa (imagem_api.py, porta 8101)
# ---------------------------------------------------------------------------
# Servico separado do Docling, no mesmo processo de instalacao. Deixe em branco
# e simplesmente nao suba a unit se nao quiser gerar imagem aqui.

IMAGEM_BIND_PORT=8101

# Qualquer modelo de texto-para-imagem que o diffusers carregue. O padrao faz
# 1024x1024 nativo, que e o tamanho que o PubliBot pede, e cabe em 8 GB com o
# offload de pesos que o servico usa.
#
# Alternativa rapida, para placa menor ou pressa: stabilityai/sdxl-turbo, com
# IMAGEM_PASSOS=2, IMAGEM_GUIDANCE=0 e capas em 512x512.
IMAGEM_MODELO=stabilityai/stable-diffusion-xl-base-1.0

# cpu | cuda | auto. Em CPU uma imagem leva minutos — serve para conferir que
# o caminho funciona, nao para uso.
IMAGEM_DEVICE=auto

# Passos de difusao e forca do prompt. A qualidade achata perto de 30 no SDXL.
IMAGEM_PASSOS=25
IMAGEM_GUIDANCE=7.0

# Segundos sem pedido ate descarregar o modelo e devolver a placa ao Ollama.
# 0 mantem carregado (maquina dedicada a imagem).
IMAGEM_OCIOSO_SEGUNDOS=300

# Teto de imagens por chamada. O PubliBot pede 3.
IMAGEM_MAXIMO=4

# Maior lado aceito. Acima disto o SDXL nao passa em 8 GB nem com offload.
IMAGEM_LADO_MAXIMO=1024
