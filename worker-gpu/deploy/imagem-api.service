# Molde, nao arquivo pronto: os marcadores em caixa alta abaixo sao trocados
# pelo `instalar.sh`. Mesmo formato do `docling-api.service`, e pelo mesmo
# motivo: um caminho fixo aqui estaria errado em toda maquina menos uma.
#
#   ./deploy/instalar.sh --imagem              unit de usuario
#   ./deploy/instalar.sh --imagem --sistema    unit de sistema (precisa de sudo)
#
# Nao edite a copia instalada: ela e reescrita a cada `instalar.sh`. O que muda
# de maquina para maquina vive no `.env`, que a unit le por EnvironmentFile.

[Unit]
Description=PubliBot — servico de imagem de capa
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
LINHA_DE_USUARIO
WorkingDirectory=RAIZ
EnvironmentFile=RAIZ/.env

# Porta propria: este servico e o Docling sao dois processos na mesma maquina,
# e um `--workers 1` em cada nao os faria caber na mesma porta.
ExecStart=RAIZ/venv/bin/uvicorn imagem_api:app \
    --host ${BIND_HOST} \
    --port ${IMAGEM_BIND_PORT} \
    --workers 1

# UM worker, como no Docling. Dois processos significam dois modelos de
# difusao residentes, e a VRAM nao comporta nem um deles duas vezes.
Restart=always
RestartSec=10

# Uma geracao de tres imagens em CPU passa de cinco minutos com folga, e e
# exatamente o caso em que nao se quer o servico morto no meio: a placa faltou
# uma vez, e reiniciar faria o pedido seguinte cair de novo.
TimeoutStopSec=900

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=ALVO_DE_INSTALACAO
