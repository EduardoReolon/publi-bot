[Unit]
Description=PubliBot (Gunicorn)
Requires=publibot.socket
After=network.target postgresql.service redis-server.service

[Service]
Type=notify
User=ubuntu
Group=www-data
RuntimeDirectory=publibot
# O socket (publibot.socket) mora nesta pasta: um restart nao pode apaga-la.
RuntimeDirectoryPreserve=yes
WorkingDirectory=/home/ubuntu/publi-bot

# Modo 0600: o .env contem a SECRET_KEY, a senha do banco e a chave que
# cifra as credenciais dos clientes.
EnvironmentFile=/home/ubuntu/publi-bot/.env
Environment=DJANGO_SETTINGS_MODULE=core.settings.prod

ExecStart=/home/ubuntu/publi-bot/venv/bin/gunicorn \
    --config /home/ubuntu/publi-bot/deploy/gunicorn/gunicorn.conf.py \
    core.wsgi:application

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=45
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/ubuntu/storage/publi-bot /home/ubuntu/publi-bot/.model_cache /run/publibot

[Install]
WantedBy=multi-user.target
