[Unit]
Description=PubliBot — worker Celery
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/publi-bot
EnvironmentFile=/home/ubuntu/publi-bot/.env
Environment=DJANGO_SETTINGS_MODULE=core.settings.prod

ExecStart=/home/ubuntu/publi-bot/venv/bin/celery -A core worker \
    --loglevel=INFO \
    --concurrency=4 \
    --prefetch-multiplier=1 \
    --max-tasks-per-child=100

# CRITICO: precisa ser MAIOR que a tarefa mais longa. Com `acks_late=True`,
# matar o worker no meio de uma tarefa faz o broker reentregar a mensagem — e
# uma implantacao publicaria o mesmo conteudo duas vezes.
TimeoutStopSec=600
KillMode=mixed
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/ubuntu/storage/publi-bot /home/ubuntu/publi-bot/.model_cache

[Install]
WantedBy=multi-user.target
