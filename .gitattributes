# Normaliza fim de linha: o repositorio guarda sempre LF.
# Isto precisa existir ANTES de deploy/ ser criado — sem ele, um .sh escrito
# no Windows chega no servidor Linux com CRLF e falha com:
#   /bin/bash^M: bad interpreter: No such file or directory
* text=auto eol=lf

# Arquivos que TEM que ser LF em qualquer sistema (executados no Linux)
*.sh            text eol=lf
*.service       text eol=lf
*.socket        text eol=lf
*.conf          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
Dockerfile      text eol=lf
Makefile        text eol=lf

# Arquivos que precisam ser CRLF (usados no Windows)
*.bat           text eol=crlf
*.ps1           text eol=crlf

# Binarios: git nunca deve tentar normalizar
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.woff          binary
*.woff2         binary
*.onnx          binary
*.zip           binary
*.gz            binary

# Diffs mais legiveis para Python
*.py            diff=python
