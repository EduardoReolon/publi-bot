# ---------------------------------------------------------------------------
# PubliBot — modelo de configuracao
#
#   cp .env.example .env    e preencha os valores
#
# Este arquivo E versionado e nao contem segredo nenhum: ele existe para
# documentar QUAIS variaveis existem. O `.env` de verdade nunca entra no git.
#
# Gere uma SECRET_KEY nova com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------

# --- Django ----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=core.settings.dev
DJANGO_SECRET_KEY=troque-por-um-valor-aleatorio-de-64-caracteres
DJANGO_ALLOWED_HOSTS=localhost,.localhost,127.0.0.1

# Dominio raiz. A home fica no apex e cada tenant num subdominio.
# Em desenvolvimento deixe "localhost": navegadores resolvem qualquer
# *.localhost para 127.0.0.1 sem precisar mexer em /etc/hosts.
# Em producao, algo como: publibot.com.br
ROOT_DOMAIN=localhost

LOG_LEVEL=INFO

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=publibot
POSTGRES_USER=publibot
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Conexao persistente no processo web. Nos processos Celery use 0.
POSTGRES_CONN_MAX_AGE=60

# --- Redis / Celery --------------------------------------------------------
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Tempo que o broker espera antes de reentregar uma mensagem ja reservada.
# O default do transporte Redis e 3600s, menos que uma inferencia longa.
CELERY_VISIBILITY_TIMEOUT=86400

# Executa tasks no proprio processo, sem worker. SOMENTE para depurar:
# mascara problemas de serializacao e de propagacao de schema.
CELERY_TASK_ALWAYS_EAGER=False

# --- Publicacao ------------------------------------------------------------
# Interruptor geral. Em False, nenhuma task envia conteudo para site nenhum.
PUBLISHING_ENABLED=True

# Monta o payload completo e registra a tentativa, mas nao faz o POST.
# E assim que se valida o contrato contra um site real sem publicar de verdade.
PUBLISH_DRY_RUN=True

# --- Recuperacao (RAG) -----------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
# O modelo trunca em 512 tokens sem avisar; este teto e validado na curadoria.
EMBEDDING_MAX_TOKENS=480

RAG_TOP_K=3
# Calibrar empiricamente: distancia de cosseno nao e comparavel entre modelos.
RAG_MAX_COSINE_DISTANCE=0.35

# --- Upload ----------------------------------------------------------------
DATA_UPLOAD_MAX_MEMORY_SIZE=52428800

# --- E-mail (somente producao) ---------------------------------------------
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=nao-responda@seu-dominio.com.br
