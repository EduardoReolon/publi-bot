# ---------------------------------------------------------------------------
# PubliBot — modelo de configuracao
#
#   cp .env.example .env    e preencha os valores
#
# Este arquivo E versionado e nao contem segredo nenhum: ele existe para
# documentar QUAIS variaveis existem. O `.env` de verdade nunca entra no git.
#
# Gere uma SECRET_KEY nova com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------

# --- Django ----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=core.settings.dev
DJANGO_SECRET_KEY=troque-por-um-valor-aleatorio-de-64-caracteres
DJANGO_ALLOWED_HOSTS=publibot.localhost,.publibot.localhost,localhost,127.0.0.1

# Dominio raiz. A home fica no apex e cada tenant num subdominio.
#
# Em desenvolvimento use DOIS rotulos, como `publibot.localhost` — nao apenas
# `localhost`. Verificado com o Chromium: um cookie com `Domain=.localhost` tem
# o atributo Domain DESCARTADO pelo navegador, porque `localhost` e tratado
# como sufixo publico. O login passa a nao atravessar para o subdominio do
# tenant, e o sintoma e a tela de login reaparecendo sem explicacao.
#
# Navegadores resolvem qualquer *.localhost para 127.0.0.1, entao
# `acme.publibot.localhost` funciona sem editar /etc/hosts.
#
# Em producao, algo como: publibot.com.br
ROOT_DOMAIN=publibot.localhost

LOG_LEVEL=INFO

# Porta do runserver. Entra no CSRF_TRUSTED_ORIGINS, porque o Django compara a
# origem completa: esquema, host E porta. Se voce rodar em outra porta sem
# ajustar isto, todo POST retorna 400 sem dizer por que.
DEV_SERVER_PORT=8000

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=publibot
POSTGRES_USER=publibot
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Conexao persistente no processo web. Nos processos Celery use 0.
POSTGRES_CONN_MAX_AGE=60

# --- Celery ----------------------------------------------------------------
# Escolhe onde a fila vive. Ver docs/adr/ADR-0013.
#
#   redis      producao, e desenvolvimento em Linux/macOS
#   postgres   desenvolvimento sem Redis instalado — util no Windows, onde nao
#              existe build oficial de Redis. Usa o MESMO banco da aplicacao,
#              montando a URL a partir das credenciais POSTGRES_* acima, e nao
#              exige nenhuma variavel adicional.
#
# O modo postgres NAO vai para producao: nao reproduz o `visibility_timeout`
# do Redis (reentrega de mensagem reservada), e a latencia e maior por causa
# do polling. As diferencas estao detalhadas no ADR.
BROKER_BACKEND=redis

REDIS_PORT=6379
# Ignorados quando BROKER_BACKEND=postgres — nesse modo as duas variaveis sao
# reescritas para apontar ao Postgres, porque o Celery le os.environ antes do
# settings do Django e um valor esquecido aqui venceria em silencio.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Prefixo de TODAS as chaves que este projeto cria no Redis.
#
# Existe porque um Redis costuma atender varios projetos, e o Celery sem
# prefixo usa nomes genericos: a fila padrao e a chave `celery`, e as mensagens
# em voo ficam em `unacked`. Duas aplicacoes na mesma base leem a MESMA fila — e
# o sintoma nao e um erro: o worker do outro projeto retira uma tarefa desta
# aplicacao, nao conhece o nome dela e a descarta. O trabalho some, e o log que
# explicaria isso esta no servidor do outro projeto.
#
# Separar so por numero de base (`/0`, `/1`) depende de ninguem repetir o
# numero, e um `FLUSHDB` de um projeto ainda levaria o outro junto.
#
# Deixe vazio apenas se o Redis for exclusivo desta aplicacao.
REDIS_NAMESPACE=publibot

# Tempo que o broker espera antes de reentregar uma mensagem ja reservada.
# O default do transporte Redis e 3600s, menos que uma inferencia longa.
CELERY_VISIBILITY_TIMEOUT=86400

# Executa tasks no proprio processo, sem worker. SOMENTE para depurar:
# mascara problemas de serializacao e de propagacao de schema.
CELERY_TASK_ALWAYS_EAGER=False

# --- Publicacao ------------------------------------------------------------
# Interruptor geral. Em False, nenhuma task envia conteudo para site nenhum.
PUBLISHING_ENABLED=True

# Monta o payload completo e registra a tentativa, mas nao faz o POST.
# E assim que se valida o contrato contra um site real sem publicar de verdade.
PUBLISH_DRY_RUN=True

# --- Credenciais de terceiros ----------------------------------------------
# Cifra as chaves de API de clientes guardadas no banco (Fernet). Vive FORA do
# banco de proposito: guardada junto, seria apenas ofuscacao. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ATENCAO: se esta chave mudar, as credenciais ja guardadas ficam
# irrecuperaveis. Guarde-a com o mesmo cuidado da DJANGO_SECRET_KEY.
NODE_KEY_ENCRYPTION_KEY=

# --- LLM (Ollama) ----------------------------------------------------------
# Semente da conexao de inferencia. Estes valores NAO sao a fonte da verdade: a
# conexao vive numa linha do banco, para que trocar de modelo nao exija
# implantacao (ADR-0012). Eles existem para o comando abaixo criar essa linha:
#
#   python manage.py configurar_inferencia --testar
#
# Idempotente: cria se faltar, PRESERVA o que ja estiver no banco. Use
# `--atualizar` quando a intencao for sobrescrever com o que esta aqui.
#
# O WORKER DE GPU, e nao mais o Ollama direto.
#
# O worker arbitra a placa: texto, imagem e conversao passam por ele e se
# revezam num lock so. Falar com o Ollama direto contorna o arbitro — e ai a
# geracao de imagem volta a encontrar a VRAM cheia.
#
#   dev :  http://127.0.0.1:8090
#   prod:  http://<nome-ou-ip-tailscale>:8090
#
# Sem barra no final e SEM `/v1`: o adaptador acrescenta a rota.
INFERENCIA_BASE_URL=http://127.0.0.1:8090

# Nome EXATO do `ollama list`. Um nome que nao existe devolve 404 em toda
# chamada, e a mensagem do Ollama nao diz que o problema e o nome.
INFERENCIA_MODELO=qwen2.5:7b-instruct

# O `WORKER_SHARED_SECRET` do `.env` do worker. As demais APIs compativeis
# com OpenAI usam este mesmo campo para a chave da conta, e a
# ausencia delas so aparece como 401 dentro de um job.
INFERENCIA_API_KEY=

# Uma inferencia por vez. Nao e ajuste de desempenho: numa placa de 8 GB duas
# chamadas simultaneas estouram a VRAM e o Ollama cai em SILENCIO para CPU —
# dezenas de vezes mais lento, sem erro nenhum no log.
INFERENCIA_CONCORRENCIA=1

# Precisa ser maior que a inferencia mais longa esperada.
INFERENCIA_RESERVA_SEGUNDOS=3600

# --- O worker de GPU -------------------------------------------------------
# Os tres endpoints de inferencia — texto, imagem e conversao de PDF — moram
# no MESMO servico, o `worker-gpu`, que vive em outro repositorio e roda na
# maquina que tem a placa. A VM da nuvem so faz requisicao HTTP (ADR-0007).
#
# Ele e um ARBITRO: a placa e indivisivel, e um modelo de texto grande ja
# ocupa quase toda a VRAM. Com tudo passando por ele, os tres trabalhos se
# revezam num lock so e ele descarrega o modelo de texto antes de gerar
# imagem. Enquanto cada cliente falava com o Ollama direto, ninguem sabia
# quando a placa estava ocupada.
#
# As tres variaveis abaixo apontam para o MESMO endereco. Continuam separadas
# porque um dia uma delas pode ser um provedor pago, e porque a reserva por
# maquina (`apps/inference/leases.py`) usa o host de cada uma para saber que
# elas dividem hardware.
#
#   dev :  http://127.0.0.1:8090
#   prod:  http://<nome-ou-ip-tailscale>:8090
#
# A RAIZ do servico, sem /v1: os clientes acrescentam o caminho.

# Conversao de PDF. O servico le a PAGINA, e nao so a camada de texto do
# arquivo: entende coluna dupla, tabela, cabecalho, rodape e legenda.
#
# Sem ele o sistema NAO para, e esse e o problema: cai no extrator local
# (pypdf), que devolve a camada de texto sem interpretar a pagina. Num artigo
# de coluna dupla as colunas se intercalam, as frases se misturam, e o texto
# continua PARECENDO correto. Por isso `PERMITIR_EXTRACAO_LOCAL` vem desligado
# em producao.
CONVERSAO_BASE_URL=
CONVERSAO_SEGREDO=
# CONVERSAO_NOME=Conversao de PDF

# Geracao de imagem de capa. Vazio e um estado legitimo e comum: sem isto o
# artigo sai igual, apenas sem capa — o passo registra o motivo e nao derruba
# o trabalho.
#
# O Ollama NAO serve aqui: ele nao gera imagem.
IMAGEM_BASE_URL=
IMAGEM_SEGREDO=
# Informativo para o worker proprio (quem manda e o .env dele); para um
# provedor pago, e o que seleciona o modelo.
# IMAGEM_MODELO=stabilityai/stable-diffusion-xl-base-1.0
# IMAGEM_NOME=Geracao de imagem

# Tamanho da capa. Viaja no pedido, entao mora AQUI e nao no .env do worker —
# trocar no lugar errado nao da erro, so nao muda nada.
#
# Decide QUALIDADE, e nao so formato. O SDXL foi treinado numa grade de
# proporcoes a area quase constante (~1,05 MP). Fora dela ele nao recusa —
# duplica o assunto e torce a geometria, sem erro nenhum.
#
# A grade inteira vem do worker: `curl -s $WORKER/health/ | jq .imagem.grade`.
# `configurar_imagem --testar` confere este valor contra ela.
#
#     1344x704   1.909:1  o padrao — o mais proximo do og:image (1200x630)
#     1344x768   1.75:1   capa larga em geral
#     1024x1024  1:1      quadrado
#     1536x640   2.4:1    panoramico
#
# `1200x630` nao passa: 630 nao e multiplo de 16, e o worker recusa com 422.
#
# Tamanho quase NAO muda o tempo: medido, 4x mais pixels custaram 23% mais
# relogio. Nao ha economia em pedir pequeno — so perda.
# IMAGEM_TAMANHO=1344x704

# Quanto esperar por um lote, em segundos. MAIOR que `imagem.tempo_travado` do
# `/health/` do worker (900s): passado esse prazo ele responde 500
# `worker_travado`, e so quem ainda esta ouvindo recebe.
# IMAGEM_TIMEOUT=960

# Prompt negativo, em ingles. O worker nao tem um proprio desde o contrato
# 2.6. Modelos destilados (guidance 0) o ignoram.
# IMAGEM_NEGATIVO=blurry, watermark, text, letters

# Onde esta o checkout do worker, quando ele mora NESTA maquina. So o
# `manage.py dev` usa, para subir o servico junto. Em producao fica vazio.
# WORKER_GPU_DIR=~/codes/worker-gpu

# Aceitar PDF lido pelo extrator local, sem analise de layout.
#
# Ligado aqui porque este e o modelo de DESENVOLVIMENTO e o sistema precisa
# ser testavel antes de o worker existir. Em producao o padrao e False, e
# subir um PDF sem conexao de conversao cadastrada vira erro — de proposito.
PERMITIR_EXTRACAO_LOCAL=True

# --- Recuperacao (RAG) -----------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
# O modelo trunca em 512 tokens sem avisar; este teto e validado na curadoria.
EMBEDDING_MAX_TOKENS=480

# Licencas cujo texto integral e APAGADO ao concluir a curadoria. Vazia por
# padrao: o sistema guarda tudo.
#
# Descartar e politica de quem opera o acervo, nao regra do software — ele nao
# tem como saber que acordo existe com cada editora. O efeito e irreversivel:
# sem o texto integral nao ha como remarcar blocos sem reenviar o arquivo.
# Valores: cc_by, cc_by_nc, open_access, proprietary, own, unknown.
LICENCAS_QUE_DESCARTAM_TEXTO_INTEGRAL=

# A capa escolhida de um artigo aprovado e servida por URL publica, porque quem
# a busca e o site de destino, do outro lado da internet e sem credencial. Estas
# tres variaveis so mudam COMO ela e entregue.
#
# Com o Nginx do deploy/ na frente, ligue X-Accel: a aplicacao devolve o
# cabecalho e quem envia os bytes e o Nginx, em vez de prender um worker do
# Gunicorn por download. Ligado SEM aquele Nginx, o navegador recebe resposta
# vazia — por isso o padrao e desligado.
USAR_X_ACCEL=false
PREFIXO_X_ACCEL=/protected-media/

# Esquema das URLs montadas para terceiros (a capa que o site de destino busca).
# Este arquivo e o modelo de DESENVOLVIMENTO, entao o valor aqui e `http`; em
# producao, `https`. Errar isto nao quebra nada de imediato: a URL sai com o
# esquema errado e o site do cliente falha ao baixar a imagem, dias depois.
ESQUEMA_PUBLICO=http

# PADRAO DE FABRICA. Desde o ADR-0016 os dois valores abaixo vivem no schema de
# cada tenant (Documentos > Qualidade da busca); o que esta aqui e apenas o
# valor com que um tenant NOVO nasce. Mudar isto nao altera nenhum tenant que ja
# exista.
RAG_TOP_K=3

# MEDIDO com o modelo acima, nao herdado de recomendacao generica. As
# distancias deste modelo se concentram entre 0.119 e 0.200 — um limiar de
# 0.35 deixaria passar ate uma passagem completamente fora do assunto.
# A distancia tambem nao e comparavel entre acervos: num corpus de tema unico
# todas encolhem. Calibre por tenant, na tela, e recalibre sempre que trocar
# EMBEDDING_MODEL. Pelo terminal, para so olhar as distancias:
#   manage.py tenant_command calibrate_retrieval --schema=<tenant> --consulta "..."
# Ver docs/adr/ADR-0014 e ADR-0016.
RAG_MAX_COSINE_DISTANCE=0.16

# Busca hibrida: uma busca por texto (termo exato: "SINAPI", "BDI", uma sigla)
# corre ao lado da vetorial, e os resultados se fundem por posicao. O limiar
# acima continua sendo a trava; quem casa por texto ganha so esta folga.
# RAG_BUSCA_HIBRIDA=True
# RAG_FOLGA_TEXTUAL=0.03

# Reordenador (cross-encoder) dos candidatos antes do corte. Vazio: desligado.
# Mais preciso que a distancia sozinha, ao custo de ~1 GB de memoria.
# RAG_RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual

# Onde o modelo (~2 GB) e cacheado, e se pode buscar na rede.
EMBEDDING_CACHE_DIR=.model_cache
EMBEDDING_LOCAL_FILES_ONLY=False

# --- Upload ----------------------------------------------------------------
DATA_UPLOAD_MAX_MEMORY_SIZE=52428800

# --- E-mail (somente producao) ---------------------------------------------
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=nao-responda@seu-dominio.com.br
