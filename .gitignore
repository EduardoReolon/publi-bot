# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
env/
.venv/
.python-version
*.egg-info/
.eggs/
build/
dist/

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
*.sqlite3
*.sqlite3-journal

# Uploads dos tenants (MEDIA_ROOT/<schema_name>/...) — nunca versionado.
media/

# Saida do collectstatic. NAO ignorar "static/", que guarda os estaticos-fonte
# do projeto e precisa ser versionado.
staticfiles/

# ---------------------------------------------------------------------------
# Variaveis de ambiente e segredos
# ---------------------------------------------------------------------------
# CUIDADO: o padrao ".env.*" tambem engoliria o .env.example, que TEM que ser
# versionado (e o unico lugar onde se documenta quais variaveis existem).
# Por isso: ignora os concretos, um a um, e nunca por curinga.
.env
.env.local
.env.dev
.env.prod
.env.worker
*.pem
*.key
!ca-bundle.crt

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid
*.pid

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log

# ---------------------------------------------------------------------------
# Cache de ferramentas
# ---------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Modelos de embedding baixados em runtime (fastembed) — ~2.2 GB, nunca no git
.model_cache/

# ---------------------------------------------------------------------------
# SO e IDEs
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Arquivos de persistencia do Redis, caso ele seja iniciado a partir
# desta pasta em vez do container.
appendonlydir/
dump.rdb

# PDFs de conferencia da extracao: obras de terceiros, cada um mantem os seus.
# Os resultados esperados ficam em fixtures/extracao/ e entram no git.
casos/

# Blocos de contexto gerados por scripts/gerar_blocos.py.
#
# Derivados do codigo, entao envelhecem a cada commit — e um bloco velho e pior
# que bloco nenhum: alguem manda para uma IA e recebe resposta confiante sobre
# codigo que nao existe mais. Regere com `python scripts/gerar_blocos.py`,
# leva menos de um segundo.
docs/blocos/
